*.py       text linguist-detectable=true diff=python
*.pyw      text linguist-detectable=true diff=python
*.pyi      text linguist-detectable=true diff=python
*.json     text linguist-detectable=true
*.md       text linguist-detectable=true
*.toml     text linguist-detectable=true
*.ini      text linguist-detectable=true
*.yaml     text linguist-detectable=true
*.yml      text linguist-detectable=true

*.lock     text

*.pyc      binary export-ignore
*.pyo      binary export-ignore
*.png      binary
*.jpg      binary
*.ico      binary

CHANGELOG  text
LICENSE    text

Dockerfile text 

*          text=auto eol=lf
